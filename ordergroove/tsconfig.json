{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "adapters/**/*.d.ts",
    "domain/**/*.ts",
    "routes/**/*.ts",
    "scenarios/**/*.ts",
    "test/**/*.ts",
    "types/**/*.ts"
  ]
}
