{
  "name": "@counterfact/ordergroove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "counterfact openapi.yaml . --generate --no-update-check",
    "start": "cross-env CHOKIDAR_USEPOLLING=1 counterfact openapi.yaml . --no-update-check",
    "serve": "cross-env CHOKIDAR_USEPOLLING=1 counterfact openapi.yaml . --serve --no-update-check",
    "test": "cross-env CHOKIDAR_USEPOLLING=1 node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "validate:openapi": "redocly lint openapi.yaml",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run generate && git diff --exit-code && npm run validate:openapi && npm run typecheck && npm test && npm run lint"
  },
  "dependencies": {
    "counterfact": "2.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@redocly/cli": "1.34.5",
    "cross-env": "^10.0.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.60.0"
  }
}
